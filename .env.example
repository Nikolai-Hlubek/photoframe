# Template -- copy to .env and fill in your own values:
#   cp .env.example .env
# The real .env is not committed.

# --- NAS access (only for the "synology" source) ---
NAS_USER=your_nas_user
NAS_PASS=your_password
NAS_BASE=http://192.168.1.10:5000     # NAS IP + port (5000 http / 5001 https)
REMOTE_DIR=/photo                     # base folder on the NAS

# --- Location for the weather (Open-Meteo) ---
WEATHER_LAT=52
WEATHER_LON=15
WEATHER_CITY=                         # optional label, e.g. Berlin

# --- Management interface (port 8081) ---
ADMIN_PASS=                           # empty = unprotected; please set one
