# Vorlage -- kopieren nach .env und eigene Werte eintragen:
#   cp .env.example .env
# Die echte .env wird nicht eingecheckt.

# --- NAS-Zugang (nur fuer Quelle "synology") ---
NAS_USER=dein_nas_benutzer
NAS_PASS=dein_passwort
NAS_BASE=http://192.168.1.10:5000     # NAS-IP + Port (5000 http / 5001 https)
REMOTE_DIR=/photo                     # Basis-Ordner auf der NAS

# --- Ort fuer das Wetter (Open-Meteo) ---
WEATHER_LAT=52
WEATHER_LON=15
WEATHER_CITY=                         # optionales Label, z.B. Berlin

# --- Management-Interface (Port 8081) ---
ADMIN_PASS=                           # leer = ungeschuetzt; bitte setzen
